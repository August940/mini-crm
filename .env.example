# Kopiér denne fil til ".env.local" og udfyld med dit eget Supabase-projekt.
#
#   cp .env.example .env.local
#
# Appen virker også HELT UDEN disse værdier: så bruger den en lokal fil-fallback
# (.data/leads.json) med seed-data. Supabase er altså valgfrit / et opgraderingstrin.
#
# Værdierne finder du i Supabase: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
